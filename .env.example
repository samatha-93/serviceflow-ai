# ServiceFlow AI - Environment Variables Reference
# Copy the respective .env.example files into client/.env and server/.env for local development

# Root workspace mode
NODE_ENV=development

# Server configurations (see server/.env.example)
# PORT=5000
# CLIENT_ORIGIN=http://localhost:5173
# MONGODB_URI=mongodb://localhost:27017/serviceflow-ai
# JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# Client configurations (see client/.env.example)
# VITE_API_URL=http://localhost:5000/api
