# Server Configuration
PORT=5000
NODE_ENV=development

# Comma-separated exact frontend origins allowed to make credentialed browser requests.
# Add each production frontend origin explicitly; no production domain is assumed.
CLIENT_ORIGINS=http://localhost:5173

# Shared per-IP fixed-window limit across login and registration
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Database Connection (MongoDB)
# If local MongoDB is not running, the server will start in offline-db mode without crashing
MONGODB_URI=mongodb://localhost:27017/serviceflow-ai

# Authentication & Security
# In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d
