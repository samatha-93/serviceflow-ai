# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin (CORS whitelist)
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB)
# If local MongoDB is not running, the server will start in offline-db mode without crashing
MONGODB_URI=mongodb://localhost:27017/serviceflow-ai

# Authentication & Security
# In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d
